FROM golang:1.25.9-bookworm@sha256:298734aec230b5f3e8cee450ce6d7eccc39f1797ba548ee90d57e9803030c6c3 AS cli
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -o /pm-cli ./cmd/pm-cli

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim@sha256:531f855bda2c73cd6ef67d56b733b357cea384185b3022bd09f05e002cd144ca
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY pm_cli_mcp/ pm_cli_mcp/
RUN uv sync --frozen --no-dev
COPY --from=cli /pm-cli /usr/local/bin/pm-cli
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 950:950
ENTRYPOINT ["/app/.venv/bin/pm-cli-mcp"]
